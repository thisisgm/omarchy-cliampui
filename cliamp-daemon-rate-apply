#!/bin/bash

# Relaunches the cliamp daemon at a given output sample rate, and only the daemon.
#
# cliamp fixes its rate at launch and has no IPC command to change it, so playing a
# file at its native rate means restarting it. That is disruptive, so this refuses
# whenever the socket belongs to an interactive session: killing someone's terminal
# player to chase a sample rate is never right.
#
# resume.json only carries a single path, not the queue, so the loaded playlist is
# recorded here and reloaded afterwards. Without that the restart leaves cliamp empty.

set -uo pipefail

unit=cliamp-daemon.service
rate="$(printf '%s' "${1:-}" | tr -cd '0-9')"
[[ -n $rate && $rate -gt 0 ]] || exit 0

systemctl --user is-active --quiet "$unit" || exit 0

field() {
  cliamp status --json 2>/dev/null | python3 -c "
import json,sys
try:
    print(json.load(sys.stdin).get(sys.argv[1]) or '')
except Exception:
    print('')
" "$1" 2>/dev/null
}

playlist="$(field playlist)"
state="$(field state)"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/cliampui"
mkdir -p "$state_dir"
printf '%s\n' "$rate" > "$state_dir/sample-rate"

systemctl --user restart "$unit"

for _ in 1 2 3 4 5 6 7 8; do
  cliamp status --json >/dev/null 2>&1 && break
  sleep 0.5
done

if [[ -n $playlist ]]; then
  cliamp load "$playlist" >/dev/null 2>&1
  sleep 1
fi

[[ $state == playing ]] && cliamp play >/dev/null 2>&1
exit 0
