#!/usr/bin/env python3

"""Print how far the sink is behind the decoder, in milliseconds.

cliamp reports the position it has decoded, which over A2DP runs about a sixth of a
second ahead of what is heard. The Latency param on cliamp's own PipeWire node covers
the whole path to the sink; pactl reports 0 usec for every sink here and cannot be used.

Prints one integer, and 0 when unknown, which leaves the position uncompensated.
"""

import json
import subprocess
import sys

NS_PER_MS = 1000000
# Beyond this the parse is wrong, and a second of lyric shift is worse than none.
MAX_SANE_MS = 2000


def dump():
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=8)
        return json.loads(out.stdout)
    except Exception:
        return []


def latency_ms(node):
    """Sample input, the Latency param PipeWire publishes on a node:
    [{"direction": "Input", "minNs": 167520833, "maxNs": 167520833}]"""
    params = ((node.get("info") or {}).get("params") or {})
    for entry in params.get("Latency") or []:
        value = entry.get("minNs")
        if isinstance(value, (int, float)) and value > 0:
            return int(value) // NS_PER_MS
    return 0


def main():
    for node in dump():
        if node.get("type") != "PipeWire:Interface:Node":
            continue
        props = (node.get("info") or {}).get("props") or {}
        name = str(props.get("application.name") or props.get("node.name") or "")
        if "cliamp" not in name.lower():
            continue
        ms = latency_ms(node)
        print(ms if 0 <= ms <= MAX_SANE_MS else 0)
        return 0

    print(0)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        print(0)
        sys.exit(1)
